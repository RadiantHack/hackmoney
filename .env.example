# =============================================================================
# OpenPay – same variables for LOCAL and REMOTE (DigitalOcean).
# Copy to .env and set values; only the values differ per environment.
# =============================================================================

# --- Database (same var name everywhere) ---
# Local:  postgres from docker-compose (see below)
# Remote: DigitalOcean managed PostgreSQL connection string
DATABASE_URL="postgresql://openpay:openpay@localhost:5432/openpay?schema=public"

# --- Redis (same var name everywhere) ---
# Local:  redis from docker-compose
# Remote: DigitalOcean managed Redis, e.g. redis://default:PASSWORD@HOST:PORT
REDIS_URL="redis://localhost:6379"

# --- API server ---
# Local:  typically 5001 (or 3000 if you prefer)
# Remote: platform sets PORT (e.g. 3000); override only if needed
PORT=5001

# --- Webapp → API (required for webapp so it can call the API) ---
# Local:  API running on same machine
# Remote: your API’s public URL, e.g. https://api-xxxx.ondigitalocean.app
NEXT_PUBLIC_API_URL="http://localhost:5001"

# --- JWT (same var names; use strong secrets in production) ---
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# --- Stripe (optional; same vars local/remote) ---
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# --- Node (optional; set by platform in production) ---
# NODE_ENV=development
# NODE_ENV=production
