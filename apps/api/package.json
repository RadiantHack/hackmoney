{
  "name": "api",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node dist/index.cjs",
    "dev": "tsup --watch --onSuccess \"node dist/index.cjs\"",
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "lint": "eslint src/ --max-warnings 0",
    "test": "jest --detectOpenHandles"
  },
  "jest": {
    "preset": "@openpay/jest-presets/node"
  },
  "dependencies": {
    "@openpay/backend": "workspace:*",
    "@openpay/error-handler": "workspace:*",
    "@openpay/logger": "workspace:*",
    "bcrypt": "^5.1.0",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "prisma": "^5.19.0"
    ,
    "viem": "^2.45.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@openpay/eslint-config": "workspace:*",
    "@openpay/jest-presets": "workspace:*",
    "@openpay/typescript-config": "workspace:*",
    "@types/bcrypt": "^5.0.2",
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.15.3",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.39.0",
    "jest": "^29.7.0",
    "supertest": "^7.1.0",
    "tsup": "^8.5.0",
    "typescript": "5.9.3"
  }
}
