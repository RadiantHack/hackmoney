    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@openpay/eslint-config": "workspace:*",
    "@openpay/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "tsup": "^8.5.0",
    "typescript": "5.9.3"
  }
}
