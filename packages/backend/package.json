{
  "name": "@openpay/backend",
  "version": "0.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "type": "module",
  "license": "MIT",
  "private": true,
  "prisma": {
    "seed": "ts-node prisma/seed/index.ts"
  },
  "scripts": {
    "prebuild": "prisma generate",
    "build": "pnpm tsup",
    "clean": "rm -rf .turbo",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:deploy": "prisma migrate deploy",
    "seed": "prisma db seed",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "check-types": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@openpay/error-handler": "workspace:*",
    "@openpay/logger": "workspace:*",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@openpay/eslint-config": "workspace:*",
    "@openpay/jest-presets": "workspace:*",
    "@openpay/typescript-config": "workspace:*",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.15.3",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "typescript": "5.9.3"
  }
}
